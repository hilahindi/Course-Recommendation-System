# Copy this file to `.env` in this directory (server/) and fill in your values.
# The app loads environment variables from server/.env via src/config.py.

# PostgreSQL — host port 5433 maps to Postgres 5432 inside Docker (see docker-compose.yml)
DATABASE_URL=postgresql://admin:password123@127.0.0.1:5433/course_recommender

# Anthropic API — required for POST /api/v1/metadata/sync-market-roles
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: CORS origin for the Vite dev server (future use)
# CORS_ORIGINS=http://localhost:5173
