# Copy this file to `.env` in this directory (server/) and fill in your values.
# The app loads environment variables from server/.env via src/config.py.

# PostgreSQL — host port 5433 maps to Postgres 5432 inside Docker (see docker-compose.yml)
DATABASE_URL=postgresql://admin:password123@127.0.0.1:5433/course_recommender

# Catalog sync on server startup (local Docker DB uses blocking; remote/cloud uses background automatically)
# blocking   — wait for sync before accepting traffic (fine for localhost)
# background — sync in a thread; server starts immediately (default for remote DATABASE_URL)
# skip       — no sync at startup (use after seed.bat / for production EC2 with pre-seeded DB)
# CATALOG_SYNC_MODE=skip

# Optional PostgreSQL client timeouts (seconds) — increase for slow cloud connections
# DB_CONNECT_TIMEOUT=60
# DB_POOL_RECYCLE=1800

# Anthropic API — required for POST /api/v1/metadata/sync-market-roles
#ANTHROPIC_API_KEY=

# Anthropic API — optional for local dev; mock market roles load when unset or placeholder
ANTHROPIC_API_KEY=demo_api_key

# Adzuna API — POST /api/v1/jobs/sync?keyword=...
ADZUNA_APP_ID=7f26efa5
ADZUNA_APP_KEY=968151b36a9bb504bade07d20340585a
ADZUNA_COUNTRY=gb
ADZUNA_SEARCH_WHAT=developer
# ADZUNA_WHERE=

# Optional: CORS origin for the Vite dev server (future use)
# CORS_ORIGINS=http://localhost:5173
